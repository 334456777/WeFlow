# shell scripts keep LF wherever they are checked out (a Windows runner with core.autocrlf would hand bash CRLF)
*.sh text eol=lf
# the HTML export's templates made small by build.mjs beside them (CI rebuilds and commits them, html-template.yml)
crates/weflow-core/src/export_msg/*.zh.html linguist-generated=true eol=lf
crates/weflow-core/src/export_msg/*.en.html linguist-generated=true eol=lf
