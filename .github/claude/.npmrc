# query() needs none of the SDK's peer dependencies (zod, @anthropic-ai/sdk, @modelcontextprotocol/sdk): they serve
# the in-process MCP tools, which this script doesn't use. Leaving them out keeps the install to the SDK and the
# Claude Code binary of the runner's platform.
legacy-peer-deps=true
audit=false
fund=false
update-notifier=false
