{
  "name": "weflow-web",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "imports": {
    "#test": "./test/index.ts"
  },
  "description": "WebUI for weflow serve",
  "license": "CC-BY-NC-SA-4.0",
  "weflow": {
    "apiVersion": "1",
    "minBackendVersion": "5.0.0"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "build": "bun --bun tsc --noEmit && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "typecheck": "bun --bun tsc --noEmit",
    "test": "bun test",
    "check": "bun run typecheck && bun test && bun --bun vite build"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "fflate": "0.8.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
