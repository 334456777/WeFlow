          },
          "createTime": {
            "type": "integer",
            "format": "int64"
          },
          "localType": {
            "type": "integer",
            "format": "int64",
            "description": "WeChat's type of the message, as a parsed message's `localType`."
          },
          "isSend": {
            "type": "integer",
            "format": "int64",
            "description": "1 when I sent it, else 0."
          },
          "senderUsername": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "description": "The message as WeChat keeps it (often XML)."
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "description": "Its text as the chat window shows it; null when it has none."
          },
          "imageMd5": {
            "type": "string"
          },
          "imageDatName": {
            "type": "string"
          },
          "videoMd5": {
            "type": "string"
          },
          "emojiMd5": {
            "type": "string"
          },
          "emojiCdnUrl": {
            "type": "string"
          },
          "xmlType": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "fileExt": {
            "type": "string"
          },
          "fileMd5": {
            "type": "string"
          },
          "fileSize": {
            "type": "integer",
            "format": "int64",
            "description": "In bytes."
          },
          "locationLat": {
            "type": "number",
            "format": "double"
          },
          "locationLng": {
            "type": "number",
            "format": "double"
          },
          "locationPoiname": {
            "type": "string"
          },
          "locationLabel": {
            "type": "string"
          },
          "appMsgKind": {
            "type": "string",
            "description": "The kind of an app message (`link`, `file`, `music`…)."
          },
          "_cursor": {
            "type": "string",
            "description": "Where the message stands in the listing (not in its conversation): `before` reads on from it."
          },
          "sessionDisplayName": {
            "type": "string"
          },
          "sessionId": {
            "type": "string"
          },
          "resourceType": {
            "$ref": "#/components/schemas/ResourceKind"
          }
        },
        "required": [
          "localId",
          "serverId",
          "createTime",
          "localType",
          "isSend",
          "senderUsername",
          "content",
          "text",
          "_cursor",
          "sessionDisplayName",
          "sessionId",
          "resourceType"
        ],
        "description": "A message of `chat resources`, newest first."
      },
      "ResourceKind": {
        "type": "string",
        "enum": [
          "image",
          "video",
          "voice",
          "file"
        ],
        "description": "What a message of `chat resources` holds."
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "command": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The command line it runs, `weflow` first (`weflow --json --progress export messages …`)."
          },
          "createdAt": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "startedAt": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0
          },
          "finishedAt": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0
          },
          "exitCode": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32"
          },
          "httpStatus": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint16",
            "minimum": 0,
            "maximum": 65535,
            "description": "The status a synchronous request would have got."
          },
          "progress": {
            "description": "The last `progress` event."
          },
          "file": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/JobFile"
              },
              {
                "type": "null"
              }
            ],
            "description": "The file of a job started with `return=file`, once it has succeeded: `GET /jobs/{id}/file`."
          },
          "result": {
            "description": "The command's `--json` document; only in `GET /jobs/{id}`."
          }
        },
        "required": [
          "id",
          "status",
          "command",
          "createdAt",
          "startedAt",
          "finishedAt",
          "exitCode",
          "httpStatus",
          "progress",
          "file"
        ],
        "description": "A job as `/jobs` answers it (`Prefer: respond-async`, #398): the command it runs, how far it is and how it ended.\nTimes are Unix milliseconds."
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "queued",
          "running",
          "succeeded",
          "failed",
          "cancelled"
        ]
      },
      "JobFile": {
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "size": {
            "type": [
              "integer",
              "null"
            ],
            "format": "uint64",
            "minimum": 0,
            "description": "In bytes."
          }
        },
        "required": [
          "name",
          "size"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "examples": [
              "invalid_arguments",
              "unauthorized",
              "invalid_host",
              "not_found",
              "method_not_allowed",
              "config_error",
              "busy",
              "user_interrupt",
              "runtime_error",
              "native_error",
              "unsupported"
            ]
          },
          "message": {
            "type": "string"
          },
          "details": true
        },
        "required": [
          "code",
          "message"
        ],
        "description": "What went wrong (`error` of a failed answer): `code` names the kind of failure, `message` says it for a person,\n`details` adds what some codes have to say."
      },
      "Row": {
        "type": "object",
        "description": "A row of one of WeChat's tables, with its columns; not described further, as WeChat decides them"
      },
      "Failure": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "const": false
          },
          "error": {
            "$ref": "#/components/schemas/Error"
          }
        }
      }
    }
  }
}
