{
  "openapi": "3.1.0",
  "info": {
    "title": "WeFlow command API contract",
    "version": "2",
    "description": "The types of the answers of the command API that the WeFlow WebUI reads (#399); `/openapi.json` of `weflow serve` describes every route. Generated by a test of weflow-cli, see docs/serve-api.md."
  },
  "paths": {
    "/api/chat/contacts": {
      "get": {
        "operationId": "api_chat_contacts",
        "x-weflow-command": "chat contacts",
        "responses": {
          "200": {
            "description": "Its `--json` document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "description": "With `parsed=true`, the contacts as the desktop app lists them; else the rows of WeChat's table",
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Contact"
                          }
                        },
                        {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Row"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "A failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/latest": {
      "get": {
        "operationId": "api_chat_latest",
        "x-weflow-command": "chat latest",
        "responses": {
          "200": {
            "description": "Its `--json` document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Row"
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "A failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/message": {
      "get": {
        "operationId": "api_chat_message",
        "x-weflow-command": "chat message",
        "responses": {
          "200": {
            "description": "Its `--json` document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "description": "With `parsed=true`, the message as the chat window shows it; else its row and the message as the query commands list it",
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/ParsedMessage"
                        },
                        {
                          "$ref": "#/components/schemas/MessageLookup"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "A failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/messages": {
      "get": {
        "operationId": "api_chat_messages",
        "x-weflow-command": "chat messages",
        "responses": {
          "200": {
            "description": "Its `--json` document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "description": "With `parsed=true`, the messages as the chat window shows them; else the rows of WeChat's table, each with its `_cursor`",
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ParsedMessage"
                          }
                        },
                        {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Row"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "A failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/resources": {
      "get": {
        "operationId": "api_chat_resources",
        "x-weflow-command": "chat resources",
        "responses": {
          "200": {
            "description": "Its `--json` document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/ResourcePage"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "A failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/search": {
      "get": {
        "operationId": "api_chat_search",
        "x-weflow-command": "chat search",
        "responses": {
          "200": {
            "description": "Its `--json` document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "description": "With `parsed=true`, the hits, each with its `_session_id`, as the chat window shows them; else the rows of WeChat's table, each with its `_cursor`",
                      "anyOf": [
                        {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/ParsedMessage"
                          }
                        },
                        {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Row"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "A failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat/sessions": {
      "get": {
        "operationId": "api_chat_sessions",
        "x-weflow-command": "chat sessions",
        "responses": {
          "200": {
            "description": "Its `--json` document",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Session"
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "A failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Failure"
                }
              }
            }
          }
        }
      }
    },
    "/jobs/{id}": {
      "get": {
        "operationId": "job",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The job",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "success",
                    "data"
                  ],
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/Job"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Session": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "The other party's wxid, `…@chatroom` for a group, `gh_…` for an official account."
          },
          "type": {
            "type": "integer",
            "format": "int64",
            "description": "WeChat's type of the conversation's row; 0 for an official account WeChat lists without one."
          },
          "unreadCount": {
            "type": "integer",
            "format": "int64"
          },
          "summary": {
            "type": "string",
            "description": "The last message as the list shows it."
          },
          "sortTimestamp": {
            "type": "integer",
            "format": "int64",
            "description": "What the list is ordered by; 0 for an official account WeChat lists without a conversation."
          },
          "lastTimestamp": {
            "type": "integer",
            "format": "int64"
          },
          "lastMsgType": {
            "type": "integer",
            "format": "int64",
            "description": "WeChat's type of the last message, as a message's `localType`."
          },
          "messageCountHint": {
            "type": "integer",
            "format": "int64",
            "description": "About how many messages the conversation has, when WeChat's row or its tables say."
          },
          "displayName": {
            "type": "string",
            "description": "The remark, else the nickname, else the username."
          },
          "lastMsgSender": {
            "type": "string",
            "description": "In a group: who sent the last message."
          },
          "lastSenderDisplayName": {
            "type": "string"
          },
          "selfWxid": {
            "type": "string",
            "description": "The account's own wxid."
          },
          "avatarUrl": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "type",
          "unreadCount",
          "summary",
          "sortTimestamp",
          "lastTimestamp",
          "lastMsgType",
          "displayName",
          "selfWxid"
        ],
        "description": "A conversation of `chat sessions`, newest first."
      },
      "ParsedMessage": {
        "type": "object",
        "properties": {
          "localId": {
            "type": "integer",
            "format": "int64",
            "description": "The message's id in its conversation's table; with `createTime`, the key of `chat message`."
          },
          "serverId": {
            "type": "string",
            "description": "WeChat's id of the message, in decimal: a string, as it may pass 2^53."
          },
          "localType": {
            "type": "integer",
            "format": "int64",
            "description": "WeChat's type of the message (1 text, 3 image, 34 voice, 43 video, 47 sticker, 49 app message, 10000 system…)."
          },
          "createTime": {
            "type": "integer",
            "format": "int64"
          },
          "sortSeq": {
            "type": "integer",
            "format": "int64",
            "description": "WeChat's order of the messages of a conversation: the send time in milliseconds, plus a little."
          },
          "isSend": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "1 when I sent it, 0 when I received it; null when the row does not say."
          },
          "senderUsername": {
            "type": [
              "string",
              "null"
            ],
            "description": "Who sent it; null when the row does not say."
          },
          "parsedContent": {
            "type": "string",
            "description": "The text the chat window shows."
          },
          "rawContent": {
            "type": "string",
            "description": "The message as WeChat keeps it (often XML)."
          },
          "emojiCdnUrl": {
            "type": "string"
          },
          "emojiMd5": {
            "type": "string"
          },
          "quotedContent": {
            "type": "string"
          },
          "quotedSender": {
            "type": "string"
          },
          "imageMd5": {
            "type": "string"
          },
          "imageDatName": {
            "type": "string"
          },
          "videoMd5": {
            "type": "string"
          },
          "voiceDurationSeconds": {
            "type": "integer",
            "format": "int64"
          },
          "aesKey": {
            "type": "string"
          },
          "encrypVer": {
            "type": "integer",
            "format": "int64"
          },
          "cdnThumbUrl": {
            "type": "string"
          },
          "cardUsername": {
            "type": "string"
          },
          "cardNickname": {
            "type": "string"
          },
          "cardAvatarUrl": {
            "type": "string"
          },
          "locationLat": {
            "type": "number",
            "format": "double"
          },
          "locationLng": {
            "type": "number",
            "format": "double"
          },
          "locationPoiname": {
            "type": "string"
          },
          "locationLabel": {
            "type": "string"
          },
          "xmlType": {
            "type": "string"
          },
          "linkTitle": {
            "type": "string"
          },
          "linkUrl": {
            "type": "string"
          },
          "linkThumb": {
            "type": "string"
          },
          "appMsgKind": {
            "type": "string"
          },
          "appMsgDesc": {
            "type": "string"
          },
          "appMsgAppName": {
            "type": "string"
          },
          "appMsgSourceName": {
            "type": "string"
          },
          "appMsgSourceUsername": {
            "type": "string"
          },
          "appMsgThumbUrl": {
            "type": "string"
          },
          "appMsgMusicUrl": {
            "type": "string"
          },
          "appMsgDataUrl": {
            "type": "string"
          },
          "appMsgLocationLabel": {
            "type": "string"
          },
          "finderNickname": {
            "type": "string"
          },
          "finderUsername": {
            "type": "string"
          },
          "finderCoverUrl": {
            "type": "string"
          },
          "finderAvatar": {
            "type": "string"
          },
          "finderDuration": {
            "type": "integer",
            "format": "int64"
          },
          "musicAlbumUrl": {
            "type": "string"
          },
          "musicUrl": {
            "type": "string"
          },
          "giftImageUrl": {
            "type": "string"
          },
          "giftWish": {
            "type": "string"
          },
          "giftPrice": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "fileSize": {
            "type": "integer",
            "format": "int64"
          },
          "fileExt": {
            "type": "string"
          },
          "fileMd5": {
            "type": "string"
          },
          "transferPayerUsername": {
            "type": "string"
          },
          "transferReceiverUsername": {
            "type": "string"
          },
          "chatRecordTitle": {
            "type": "string"
          },
          "messageKey": {
            "type": "string",
            "description": "The message's key as the desktop app builds it."
          },
          "_cursor": {
            "type": "string",
            "description": "Where the message stands in its conversation: pass it as `before` or `after` to read the messages next to it.\nIt is opaque; only the server reads it."
          },
          "_session_id": {
            "type": "string",
            "description": "The conversation of a search hit."
          }
        },
        "required": [
          "localId",
          "serverId",
          "localType",
          "createTime",
          "sortSeq",
          "isSend",
          "senderUsername",
          "parsedContent",
          "rawContent",
          "messageKey"
        ],
        "description": "A message of a page as the chat window shows it (`chat messages`, `chat message` and `chat search` with\n`parsed`)."
      },
      "MessageLookup": {
        "type": "object",
        "properties": {
          "row": {
            "description": "The row, with its columns."
          },
          "message": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MessageView"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null when the row could not be read as a message."
          }
        },
        "required": [
          "row",
          "message"
        ],
        "description": "`chat message` without `parsed`: the row of WeChat's table, and the message as the query commands list it."
      },
      "MessageView": {
        "type": "object",
        "properties": {
          "localId": {
            "type": "integer",
            "format": "int64"
          },
          "serverId": {
            "type": "string",
            "description": "WeChat's id of the message, in decimal: a string, as it may pass 2^53."
          },
          "createTime": {
            "type": "integer",
            "format": "int64"
          },
          "localType": {
            "type": "integer",
            "format": "int64",
            "description": "WeChat's type of the message, as a parsed message's `localType`."
          },
          "isSend": {
            "type": "integer",
            "format": "int64",
            "description": "1 when I sent it, else 0."
          },
          "senderUsername": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "description": "The message as WeChat keeps it (often XML)."
          },
          "text": {
            "type": [
              "string",
              "null"
            ],
            "description": "Its text as the chat window shows it; null when it has none."
          },
          "imageMd5": {
            "type": "string"
          },
          "imageDatName": {
            "type": "string"
          },
          "videoMd5": {
            "type": "string"
          },
          "emojiMd5": {
            "type": "string"
          },
          "emojiCdnUrl": {
            "type": "string"
          },
          "xmlType": {
            "type": "string"
          },
          "fileName": {
            "type": "string"
          },
          "fileExt": {
            "type": "string"
          },
          "fileMd5": {
            "type": "string"
          },
          "fileSize": {
            "type": "integer",
            "format": "int64",
            "description": "In bytes."
          },
          "locationLat": {
            "type": "number",
            "format": "double"
          },
          "locationLng": {
            "type": "number",
            "format": "double"
          },
          "locationPoiname": {
            "type": "string"
          },
          "locationLabel": {
            "type": "string"
          },
          "appMsgKind": {
            "type": "string",
            "description": "The kind of an app message (`link`, `file`, `music`…)."
          }
        },
        "required": [
          "localId",
          "serverId",
          "createTime",
          "localType",
          "isSend",
          "senderUsername",
          "content",
          "text"
        ],
        "description": "A message as the query commands list it (`chat resources`, `chat images`, `chat media-stream`…): the main fields\nof its row, its text and the keys of its media. An optional field is left out when the message has none."
      },
      "Contact": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "displayName": {
            "type": "string",
            "description": "The remark, else the nickname, else the WeChat ID, else the username."
          },
          "remark": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          },
          "alias": {
            "type": "string",
            "description": "The WeChat ID."
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The names of the contact's labels."
          },
          "detailDescription": {
            "type": "string",
            "description": "The signature."
          },
          "region": {
            "type": "string"
          },
          "type": {
            "$ref": "#/components/schemas/ContactKind"
          },
          "avatarUrl": {
            "type": "string"
          }
        },
        "required": [
          "username",
          "displayName",
          "type"
        ],
        "description": "A contact of `chat contacts --parsed`, as the desktop app lists it: the most recent conversation first, then by\nname. A text field is left out when it is empty."
      },
      "ContactKind": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "friend",
              "group",
              "official"
            ]
          },
          {
            "type": "string",
            "const": "former_friend",
            "description": "Someone who was a friend."
          }
        ],
        "description": "What a contact of `chat contacts --parsed` is."
      },
      "ResourcePage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Resource"
            }
          },
          "hasMore": {
            "type": "boolean"
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "The `_cursor` of the last item, to pass as `before` for the next page; null on the last page."
          }
        },
        "required": [
          "items",
          "hasMore",
          "nextCursor"
        ],
        "description": "A page of `chat resources`."
      },
      "Resource": {
        "type": "object",
        "properties": {
          "localId": {
            "type": "integer",
            "format": "int64"
          },
          "serverId": {
            "type": "string",
